# Used only for local development (npm start inside mail-srv/).
# In Cloud Foundry, these come from the "supplierportal-smtp-credentials"
# user-provided service instead - see the deployment instructions.
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=changeme
SMTP_SENDER_NAME=Supplier Portal
PORT=4004
