<mvc:View
    controllerName="supplierportal.controller.rfqdetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
>
    <Page
        id="rfqDetailPage"
        title="{i18n>rfqDetailsTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <VBox id="rfqDetailContent" class="supplierContent">
                <ObjectHeader
                    id="rfqObjectHeader"
                    class="supplierCard"
                    title="{rfqDetail>/header/RequestForQuotation}"
                    intro="{rfqDetail>/header/RFQDescription}"
                    number="{rfqDetail>/header/TargetValue}"
                    numberUnit="{rfqDetail>/header/DocumentCurrency}"
                >
                    <attributes>
                        <ObjectAttribute id="rfqObjectType" title="{i18n>rfqType}" text="{rfqDetail>/header/RFQType}" />
                        <ObjectAttribute id="rfqObjectOrg" title="{i18n>purchasingOrganization}" text="{rfqDetail>/header/PurchasingOrganization}" />
                        <ObjectAttribute id="rfqObjectGroup" title="{i18n>purchasingGroup}" text="{rfqDetail>/header/PurchasingGroup}" />
                    </attributes>
                </ObjectHeader>

                <VBox id="rfqGeneralCard" class="supplierCard supplierCardPadded sapUiSmallMarginTop">
                    <Title id="rfqGeneralTitle" text="{i18n>rfqBasicData}" class="sapUiSmallMarginBottom" />
                    <l:Grid id="rfqGeneralGrid" defaultSpan="XL3 L4 M6 S12">
                        <VBox id="rfqTypeBox"><Label id="rfqTypeLabel" text="{i18n>rfqType}" /><Text id="rfqTypeValue" text="{rfqDetail>/header/RFQType}" /></VBox>
                        <VBox id="rfqDescriptionBox"><Label id="rfqDescriptionLabel" text="{i18n>rfqDescription}" /><Text id="rfqDescriptionValue" text="{rfqDetail>/header/RFQDescription}" /></VBox>
                        <VBox id="rfqLanguageBox"><Label id="rfqLanguageLabel" text="{i18n>rfqLanguage}" /><Text id="rfqLanguageValue" text="{rfqDetail>/header/Language}" /></VBox>
                        <VBox id="rfqCurrencyBox"><Label id="rfqCurrencyLabel" text="{i18n>documentCurrency}" /><Text id="rfqCurrencyValue" text="{rfqDetail>/header/DocumentCurrency}" /></VBox>
                        <VBox id="rfqTargetValueBox"><Label id="rfqTargetValueLabel" text="{i18n>targetValue}" /><Text id="rfqTargetValueValue" text="{rfqDetail>/header/TargetValue}" /></VBox>
                        <VBox id="rfqFollowOnBox"><Label id="rfqFollowOnLabel" text="{i18n>followOnDocType}" /><Text id="rfqFollowOnValue" text="{rfqDetail>/header/FollowOnDocumentType}" /></VBox>
                    </l:Grid>
                </VBox>

                <VBox id="rfqOrganizationCard" class="supplierCard supplierCardPadded sapUiSmallMarginTop">
                    <Title id="rfqOrganizationTitle" text="{i18n>rfqOrganization}" class="sapUiSmallMarginBottom" />
                    <l:Grid id="rfqOrganizationGrid" defaultSpan="XL3 L4 M6 S12">
                        <VBox id="rfqPurchasingOrgBox"><Label id="rfqPurchasingOrgLabel" text="{i18n>purchasingOrganization}" /><Text id="rfqPurchasingOrgValue" text="{rfqDetail>/header/PurchasingOrganization}" /></VBox>
                        <VBox id="rfqPurchasingGroupBox"><Label id="rfqPurchasingGroupLabel" text="{i18n>purchasingGroup}" /><Text id="rfqPurchasingGroupValue" text="{rfqDetail>/header/PurchasingGroup}" /></VBox>
                        <VBox id="rfqCompanyCodeBox"><Label id="rfqCompanyCodeLabel" text="{i18n>companyCode}" /><Text id="rfqCompanyCodeValue" text="{rfqDetail>/header/CompanyCode}" /></VBox>
                        <VBox id="rfqCreatedByBox"><Label id="rfqCreatedByLabel" text="{i18n>createdBy}" /><Text id="rfqCreatedByValue" text="{rfqDetail>/header/CreatedBy}" /></VBox>
                    </l:Grid>
                </VBox>

                <VBox id="rfqDatesCard" class="supplierCard supplierCardPadded sapUiSmallMarginTop">
                    <Title id="rfqDatesTitle" text="{i18n>rfqImportantDates}" class="sapUiSmallMarginBottom" />
                    <l:Grid id="rfqDatesGrid" defaultSpan="XL3 L4 M6 S12">
                        <VBox id="rfqPublishingDateBox"><Label id="rfqPublishingDateLabel" text="{i18n>publishingDate}" /><Text id="rfqPublishingDateValue" text="{path: 'rfqDetail>/header/PublishingDate', formatter: '.formatter.odataDate'}" /></VBox>
                        <VBox id="rfqDeadlineBox"><Label id="rfqDeadlineLabel" text="{i18n>quotationDeadline}" /><Text id="rfqDeadlineValue" text="{path: 'rfqDetail>/header/QuotationDeadline', formatter: '.formatter.odataDate'}" /></VBox>
                        <VBox id="rfqCreationDateBox"><Label id="rfqCreationDateLabel" text="{i18n>createdOn}" /><Text id="rfqCreationDateValue" text="{path: 'rfqDetail>/header/CreationDate', formatter: '.formatter.odataDate'}" /></VBox>
                    </l:Grid>
                </VBox>

                <VBox id="rfqItemsCard" class="supplierCard supplierCardPadded sapUiSmallMarginTop">
                    <Title id="rfqItemsTitle" text="{i18n>rfqSectionItems}" class="sapUiSmallMarginBottom" />
                    <Table
                        id="rfqItemsTable"
                        items="{rfqDetail>/items}"
                        noDataText="{i18n>rfqNoItems}"
                        growing="true"
                        growingScrollToLoad="true"
                        fixedLayout="false"
                    >
                        <columns>
                            <Column id="rfqItemNumberColumn"><Text id="rfqItemNumberHeader" text="{i18n>rfqItem}" /></Column>
                            <Column id="rfqItemScheduleColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqItemScheduleHeader" text="{i18n>rfqScheduleLine}" /></Column>
                            <Column id="rfqItemDescriptionColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqItemDescriptionHeader" text="{i18n>rfqShortText}" /></Column>
                            <Column id="rfqItemMaterialColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqItemMaterialHeader" text="{i18n>rfqMaterial}" /></Column>
                            <Column id="rfqItemMaterialGroupColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemMaterialGroupHeader" text="{i18n>rfqMaterialGroup}" /></Column>
                            <Column id="rfqItemPlantColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemPlantHeader" text="{i18n>rfqPlant}" /></Column>
                            <Column id="rfqItemQuantityColumn" hAlign="End"><Text id="rfqItemQuantityHeader" text="{i18n>rfqRequestedQuantity}" /></Column>
                            <Column id="rfqItemUnitColumn"><Text id="rfqItemUnitHeader" text="{i18n>rfqOrderUnit}" /></Column>
                            <Column id="rfqItemBaseUnitColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemBaseUnitHeader" text="{i18n>rfqBaseUnit}" /></Column>
                            <Column id="rfqItemDeliveryColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqItemDeliveryHeader" text="{i18n>rfqDeliveryDate}" /></Column>
                            <Column id="rfqItemRequisitionColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemRequisitionHeader" text="{i18n>rfqPurchaseRequisition}" /></Column>
                            <Column id="rfqItemRequisitionItemColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemRequisitionItemHeader" text="{i18n>rfqPurchaseRequisitionItem}" /></Column>
                            <Column id="rfqItemIncotermsColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemIncotermsHeader" text="{i18n>rfqIncoterms}" /></Column>
                            <Column id="rfqItemIncotermsLocation1Column" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemIncotermsLocation1Header" text="{i18n>rfqIncotermsLocation1}" /></Column>
                            <Column id="rfqItemIncotermsLocation2Column" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemIncotermsLocation2Header" text="{i18n>rfqIncotermsLocation2}" /></Column>
                            <Column id="rfqItemManufacturerColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemManufacturerHeader" text="{i18n>rfqManufacturer}" /></Column>
                            <Column id="rfqItemManufacturerPartNoColumn" minScreenWidth="Desktop" demandPopin="true"><Text id="rfqItemManufacturerPartNoHeader" text="{i18n>rfqManufacturerPartNo}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="rfqItemRow" vAlign="Middle">
                                <cells>
                                    <Text id="rfqItemNumber" text="{rfqDetail>RequestForQuotationItem}" />
                                    <Text id="rfqItemSchedule" text="{rfqDetail>ScheduleLine}" />
                                    <Text id="rfqItemDescription" text="{rfqDetail>ShortText}" />
                                    <Text id="rfqItemMaterial" text="{rfqDetail>Material}" />
                                    <Text id="rfqItemMaterialGroup" text="{rfqDetail>MaterialGroup}" />
                                    <Text id="rfqItemPlant" text="{rfqDetail>Plant}" />
                                    <Text id="rfqItemQuantity" text="{rfqDetail>RequestedQuantity}" />
                                    <Text id="rfqItemUnit" text="{rfqDetail>OrderQuantityUnit}" />
                                    <Text id="rfqItemBaseUnit" text="{rfqDetail>BaseUnit}" />
                                    <Text id="rfqItemDelivery" text="{path: 'rfqDetail>DeliveryDate', formatter: '.formatter.odataDate'}" />
                                    <Text id="rfqItemRequisition" text="{rfqDetail>PurchaseRequisition}" />
                                    <Text id="rfqItemRequisitionItem" text="{rfqDetail>PurchaseRequisitionItem}" />
                                    <Text id="rfqItemIncoterms" text="{rfqDetail>IncotermsClassification}" />
                                    <Text id="rfqItemIncotermsLocation1" text="{rfqDetail>IncotermsLocation1}" />
                                    <Text id="rfqItemIncotermsLocation2" text="{rfqDetail>IncotermsLocation2}" />
                                    <Text id="rfqItemManufacturer" text="{rfqDetail>Manufacturer}" />
                                    <Text id="rfqItemManufacturerPartNo" text="{rfqDetail>ManufacturerPartNumber}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <VBox id="rfqBiddersCard" class="supplierCard supplierCardPadded sapUiSmallMarginTop">
                    <Title id="rfqBiddersTitle" text="{i18n>rfqSectionBidders}" class="sapUiSmallMarginBottom" />
                    <Table
                        id="rfqBiddersTable"
                        items="{rfqDetail>/bidders}"
                        noDataText="{i18n>rfqNoBidders}"
                        growing="true"
                        fixedLayout="false"
                    >
                        <columns>
                            <Column id="rfqBidderSupplierColumn"><Text id="rfqBidderSupplierHeader" text="{i18n>rfqSupplier}" /></Column>
                            <Column id="rfqBidderNameColumn"><Text id="rfqBidderNameHeader" text="{i18n>rfqSupplierName}" /></Column>
                            <Column id="rfqBidderFunctionColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqBidderFunctionHeader" text="{i18n>rfqPartnerFunction}" /></Column>
                            <Column id="rfqBidderCounterColumn" minScreenWidth="Tablet" demandPopin="true"><Text id="rfqBidderCounterHeader" text="{i18n>rfqPartnerCounter}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="rfqBidderRow" vAlign="Middle">
                                <cells>
                                    <Text id="rfqBidderSupplier" text="{rfqDetail>Supplier}" />
                                    <Text id="rfqBidderName" text="{rfqDetail>SupplierName}" />
                                    <Text id="rfqBidderFunction" text="{rfqDetail>PartnerFunction}" />
                                    <Text id="rfqBidderCounter" text="{rfqDetail>PartnerCounter}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
